# Application
APP_NAME=DevPilot API
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg://devpilot:devpilot@localhost:5432/devpilot

# Auth
# Generate a strong value for any non-dev environment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS: comma-separated list of allowed browser origins (the frontend URL)
CORS_ORIGINS=http://localhost:3000

# Password reset. Reset links point at the web app: set its public URL (no
# trailing slash). See docs/password-reset.md.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Outgoing email: "console" prints emails (with the reset link) to the API's
# stdout — local development only. Production uses "resend" + an API key from
# https://resend.com (sending access only). Never commit a real key.
EMAIL_BACKEND=console
EMAIL_FROM=DevPilot <dev@localhost>
RESEND_API_KEY=

# Optional: create this account on startup with an unusable password; its owner
# sets one via "Forgot password?". For deployments where sign-up is off.
BOOTSTRAP_USER_EMAIL=

# LLM
LLM_PROVIDER=openai
LLM_MODEL=

# OpenAI
OPENAI_API_KEY=

# Hugging Face
HF_API_KEY=

# GitHub (Phase 4): fine-grained PAT with Contents + Issues + Pull requests
# (read/write) on the repos DevPilot may touch. Server-side only. If empty, the
# API falls back to the host's `gh auth token`.
GITHUB_TOKEN=

# Repository RAG (Phase 6). Local embeddings via fastembed (no key); the model is
# downloaded once from Hugging Face and must produce 384-d vectors.
RAG_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
