# Application
APP_NAME=DevPilot API
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg://devpilot:devpilot@localhost:5432/devpilot

# Auth
# Generate a strong value for any non-dev environment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM
LLM_PROVIDER=openai
LLM_MODEL=

# OpenAI
OPENAI_API_KEY=

# Hugging Face
HF_API_KEY=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
